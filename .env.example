# ---------------------------------------------------------------------------
# The ONLY credential this project needs.
#
# Every model -- benchmark targets and judges alike -- is called through
# OpenRouter. There is no vendor API key here on purpose: no OPENAI_API_KEY,
# no GOOGLE_API_KEY, no MISTRAL_API_KEY, no BYOK vendor key. If you ever need
# one to run this benchmark, that is a bug.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# Optional OpenRouter attribution metadata (shown on openrouter.ai rankings).
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_NAME=

# Optional: local path to your own copy of the AI-Hub
# "추상 요약 사실성 검증" dataset. The data is licence-gated and is never
# downloaded automatically; without this the Korean hallucination benchmark
# reports SKIPPED and everything else still runs.
AIHUB_FACTUALITY_DATA_PATH=

# Optional: HuggingFace token, only needed if you hit anonymous rate limits
# while downloading the public datasets during `benchmark prepare`.
HF_TOKEN=
